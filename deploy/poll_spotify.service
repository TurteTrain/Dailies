[Unit]
Description=Poll Spotify listening history
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/dailies/backend
ExecStart=/opt/dailies/venv/bin/python manage.py poll_spotify
EnvironmentFile=/opt/dailies/backend/.env
StandardOutput=journal
StandardError=journal
