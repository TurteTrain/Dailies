[Unit]
Description=Poll Spotify listening history
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/Dailies/backend
ExecStart=/home/ubuntu/Dailies/venv/bin/python manage.py poll_spotify
EnvironmentFile=/home/ubuntu/Dailies/backend/.env
StandardOutput=journal
StandardError=journal
